{
  "name": "page-load-anatomy",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A dissectible model of what actually happens when a browser loads a page",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b packages/core packages/observe packages/element"
  },
  "devDependencies": {
    "jsdom": "^30.0.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
